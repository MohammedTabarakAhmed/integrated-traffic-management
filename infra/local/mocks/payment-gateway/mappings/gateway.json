{
  "mappings": [
    {
      "request": { "method": "POST", "url": "/v1/payment-sessions" },
      "response": {
        "status": 201,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "sessionId": "{{randomValue type='UUID'}}",
          "redirectUrl": "http://localhost:5173/mock-gateway/pay/{{jsonPath request.body '$.merchantRef'}}?amount={{jsonPath request.body '$.amountMinor'}}&currency={{jsonPath request.body '$.currency'}}&return={{urlEncode (jsonPath request.body '$.returnUrl')}}"
        },
        "transformers": ["response-template"]
      }
    },
    {
      "request": { "method": "GET", "urlPathPattern": "/v1/payments/[0-9a-f-]+/status" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "status": "PENDING" }
      }
    },
    {
      "request": { "method": "POST", "url": "/v1/refunds" },
      "response": {
        "status": 201,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "refundRef": "RF-{{randomValue type='UUID'}}" },
        "transformers": ["response-template"]
      }
    }
  ]
}
