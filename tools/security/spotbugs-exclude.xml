<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs/FindSecBugs exclusions (SEC-021; ADR-036). Every entry names the finding, where it is and why it is not a
     defect. Never exclude a whole category or package without a reason reviewed like code. A new finding fails the
     build until it is fixed or added here with its reason. -->
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0">

  <!-- EI_EXPOSE_REP2 on injected collaborators: the constructor keeps a Spring singleton (repository port, ObjectMapper,
