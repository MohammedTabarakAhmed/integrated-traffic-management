  <!-- EI_EXPOSE_REP2 on the same records (Increments 2-9): their compact constructors store an unmodifiable copy
       (Collections.unmodifiableList/Map of a new ArrayList/LinkedHashMap, or List.copyOf), so the caller's collection
       is never kept. SpotBugs reports the parameter before the reassignment. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Or>
      <And><Class name="gov.itms.accident.application.AccidentService$Report"/><Field name="~parties|evidenceDocumentIds"/></And>
      <And><Class name="gov.itms.crossborder.application.CrossborderService$Message"/><Field name="payload"/></And>
      <And><Class name="gov.itms.crossborder.application.CrossborderService$StatementView"/><Field name="lines"/></And>
      <And><Class name="gov.itms.crossborder.application.Ports$Proposal"/><Field name="payload"/></And>
      <And><Class name="gov.itms.licensing.application.LicenceNumberService$Report"/><Field name="ranges"/></And>
      <And><Class name="gov.itms.licensing.application.LicenceRepository$HistoryEntry"/><Field name="detail"/></And>
      <And><Class name="gov.itms.licensing.application.LicenceStatusService$Status"/><Field name="classes"/></And>
      <And><Class name="gov.itms.licensing.domain.LicenceRequest"/><Field name="~payload|transferIds"/></And>
      <And><Class name="gov.itms.licensing.infrastructure.LicensingServiceConfiguration$ForeignProperties"/><Field name="~acceptedLanguages|idpPrinters"/></And>
      <And><Class name="gov.itms.payment.application.FinanceOperations$ClosedTill"/><Field name="totals"/></And>
      <And><Class name="gov.itms.rental.application.RentalService$Contract"/><Field name="additionalDrivers"/></And>
      <And><Class name="gov.itms.roadpermit.application.RoadPermitService$Application"/><Field name="~vehicles|routeSegments"/></And>
      <And><Class name="gov.itms.vehicle.application.PlateService$AuctionView"/><Field name="~lots|highestBids"/></And>
      <And><Class name="gov.itms.vehicle.application.PlateService$OrderView"/><Field name="items"/></And>
      <And><Class name="gov.itms.vehicle.application.VehicleTransactions$FileRecords"/><Field name="~bans|approvals|mortgages|cards|certificates"/></And>
      <And><Class name="gov.itms.vehicle.domain.Records$Approval"/><Field name="detail"/></And>
      <And><Class name="gov.itms.vehicle.domain.Registration$Request"/><Field name="payload"/></And>
    </Or>
  </Match>

  <!-- SPRING_CSRF_PROTECTION_DISABLED: the API is stateless (SessionCreationPolicy.STATELESS) and authenticates only
       with a bearer token in the Authorization header; no cookie or session authenticates a request, so a cross-site
       request cannot carry the user's credentials (OWASP CSRF cheat sheet). -->
  <Match>
    <Bug pattern="SPRING_CSRF_PROTECTION_DISABLED"/>
    <Class name="gov.itms.platform.security.ItmsSecurityAutoConfiguration"/>
  </Match>

  <!-- XSS_SERVLET: the filters write an RFC 9457 problem document serialised by Jackson with content type
       application/problem+json; no HTML is produced and every value is JSON-escaped. -->
  <Match>
    <Bug pattern="XSS_SERVLET"/>
    <Or>
      <And><Class name="gov.itms.platform.idempotency.IdempotencyFilter"/><Method name="writeProblem"/></And>
      <And><Class name="gov.itms.platform.security.AuthorisationFilter"/><Method name="writeUnavailable"/></And>
    </Or>
  </Match>

  <!-- UNVALIDATED_REDIRECT: a replay (ADR-032) repeats the Location header of this service's own earlier 2xx response
       to the same principal and key; it never comes from the request. -->
  <Match>
    <Bug pattern="UNVALIDATED_REDIRECT"/>
    <Class name="gov.itms.platform.idempotency.IdempotencyFilter"/>
    <Method name="replay"/>
  </Match>

  <!-- REDOS: ServiceSpec.SLA_PATTERN has only bounded quantifiers (\d{1,4}, \d{1,5}, \d{1,6}) and optional groups that
       cannot overlap (D, T...H, M), so matching is linear in the input; the SLA field is also length-limited by the
       OpenAPI schema. -->
  <Match>
    <Bug pattern="REDOS"/>
    <Class name="gov.itms.transaction.domain.ServiceSpec"/>
  </Match>

  <!-- REDOS: JdbcDomainEventRecorder.EVENT_TYPE ([a-z][a-z0-9]*(\.[a-z][a-z0-9-]*)+) cannot backtrack: each repeated group
       must start with a literal dot that no character class in the pattern matches, so every input has one parse and
       matching is linear. Event types are code constants of the services, never request input (ADR-040). -->
  <Match>
    <Bug pattern="REDOS"/>
    <Class name="gov.itms.platform.events.JdbcDomainEventRecorder"/>
  </Match>
  <!-- CT_CONSTRUCTOR_THROW: DuplicateMergeService refuses a similarity threshold outside (0, 1] when Spring creates the
       singleton from configuration, so a misconfigured service never starts. A finalizer attack needs hostile code
       subclassing it inside the service; the class stays non-final because Spring proxies it for @Transactional. -->
  <Match>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    <Class name="gov.itms.trafficfile.application.DuplicateMergeService"/>
  </Match>

  <!-- CT_CONSTRUCTOR_THROW (Increments 4, 6, 9): these services refuse an out-of-range setting (objection window,
       maximum capture lag, delivery batch size) when Spring creates the singleton from configuration, so a
       misconfigured service never starts. A finalizer attack needs hostile code subclassing them inside the service;
       they stay non-final because Spring proxies them for @Transactional. -->
  <Match>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    <Or>
      <Class name="gov.itms.accident.application.AccidentWorkflowService"/>
      <Class name="gov.itms.crossborder.application.ExchangeDelivery"/>
      <Class name="gov.itms.device.application.DeviceService"/>
      <Class name="gov.itms.violation.application.ObjectionService"/>
    </Or>
  </Match>

  <!-- UNENCRYPTED_SOCKET: ClamAV's clamd INSTREAM protocol has no TLS. The scanner runs beside document-service in the
       application zone, reachable only from it (network policy, SECURITY_DESIGN zones); production scanner choice and
       transport protection are open with security (Q-067). Reviewed as a deliberate, recorded exception. -->
  <Match>
    <Bug pattern="UNENCRYPTED_SOCKET"/>
    <Class name="gov.itms.document.infrastructure.ClamdScanner"/>
  </Match>

  <!-- VA_FORMAT_STRING_USES_NEWLINE: HtmlCertificateRenderer formats an HTML text block; its line breaks are part of the
       document and must be LF on every platform, so %n (the platform separator) would be wrong. -->
  <Match>
    <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
    <Class name="gov.itms.document.infrastructure.HtmlCertificateRenderer"/>
  </Match>
</FindBugsFilter>
